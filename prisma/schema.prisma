generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

model Product {
    id          Int          @id @default(autoincrement())
    name        String
    price       Decimal      @db.Decimal(10, 2)
    description String?
    createdAt   DateTime     @default(now())
    inStock     Boolean      @default(true)
    isFeatured  Boolean      @default(false)
    categoryId  Int?
    category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    tags        ProductTag[]
}

model Category {
    id       Int       @id @default(autoincrement())
    name     String    @unique
    products Product[]
}

model Tag {
    id       Int          @id @default(autoincrement())
    name     String       @unique
    products ProductTag[]
}

model ProductTag {
    id Int @id @default(autoincrement())

    productId Int
    product   Product @relation(fields: [productId], references: [id])

    tagId Int
    tag   Tag @relation(fields: [tagId], references: [id])

    // La COPPIA è unica: lo stesso tag una volta sola per prodotto.
    @@unique([productId, tagId])
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    name     String
    password String

    // Singolare e opzionale: l'utente può esistere senza profilo.
    profile Profile?
}

model Profile {
    id     Int     @id @default(autoincrement())
    bio    String? @db.Text
    avatar String?

    // FK con @unique: UN solo profilo per utente.
    userId Int  @unique
    user   User @relation(fields: [userId], references: [id])
}
