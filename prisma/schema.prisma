generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

model Product {
    id          Int      @id @default(autoincrement())
    name        String
    price       Decimal  @db.Decimal(10, 2)
    description String?
    createdAt   DateTime @default(now())
    inStock     Boolean  @default(true)
    isFeatured  Boolean  @default(false)
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    name     String
    password String
}

model Profile {
    id     Int     @id @default(autoincrement())
    bio    String? @db.Text
    avatar String?
}
